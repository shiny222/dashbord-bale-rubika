# ─────────────────────────────────────────────────────────────
# Telegram Bot Dashboard — environment configuration
# Copy this file to /etc/telegram-bot-dashboard.env on the
# server (or to `.env` locally for development) and fill in
# real values. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────

# The two managed Telegram bots (add more pairs if needed:
# BOT_3_NAME, BOT_3_SERVICE, ... up to BOT_10_*).
# Replace the service names with your real systemd unit names,
# e.g. mybot_bale.service / mybot_rubika.service.
BOT_1_NAME=Telegram Bot 1
BOT_1_SERVICE=my-first-bot.service

BOT_2_NAME=Telegram Bot 2
BOT_2_SERVICE=my-second-bot.service

# Telegram Local Bot API server (systemd service + HTTP endpoint).
# The endpoint is used for the health check; no bot token is needed.
TELEGRAM_API_SERVICE=telegram-bot-api.service
TELEGRAM_API_URL=http://127.0.0.1:8081
TELEGRAM_API_TIMEOUT_MS=3000
# Set to false to hide the start/stop/restart buttons for the API service.
TELEGRAM_API_CONTROL_ENABLED=true

# Dashboard server
PORT=3000
# Bind address. Keep 127.0.0.1 when Nginx terminates HTTPS on this host.
HOST=127.0.0.1

# Security
# Generate with:  openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret
# Generate with:  node server/scripts/hash-password.js 'your-password'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-a-secure-password-hash

# Set to true when the app is served over HTTPS (behind Nginx).
SECURE_COOKIES=false
# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Comma-separated list of extra origins allowed by the same-origin CSRF
# check. Use this when the dashboard is reached through a hostname/proxy
# whose Host header differs from the browser Origin (e.g.
# ALLOWED_ORIGINS=https://dashboard.example.com,http://192.168.1.10:3000).
# Set to * to allow any origin (disables the origin check - not recommended).
ALLOWED_ORIGINS=
# Use `sudo -n systemctl ...` for start/stop/restart (recommended).
# Set to false only if the dashboard process already runs with privileges.
USE_SUDO=true

# Command timeouts (milliseconds)
COMMAND_TIMEOUT_MS=15000
# Log level: debug | info | warn | error
LOG_LEVEL=info
